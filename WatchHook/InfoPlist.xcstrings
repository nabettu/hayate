        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar sözcükle başlayan notları, seçtiğiniz listeye anımsatıcı olarak ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нотатки, що починаються з ключового слова, додаються як нагадування до вибраного списку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayate کو آپ کی یاد دہانیاں تک مکمل رسائی چاہیے تاکہ وہ نوٹ آپ کی منتخب فہرست میں شامل کر سکے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayate cần quyền truy cập đầy đủ vào Lời nhắc để thêm ghi chú vào danh sách bạn chọn."
          }
        },
        "zh-Hans" : {
