          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir Hayate y pulsar “Enviar” enseguida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauttamalla Hayate avautuu, ja voit heti painaa ”Lähetä”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour ouvrir Hayate et appuyer tout de suite sur « Envoyer »."
