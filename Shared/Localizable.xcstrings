            "state" : "translated",
            "value" : "بعد میں دوبارہ بھیجیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi lại sau"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稍后重新发送"
