    "Siri で送るときは、送り先を指定していなければ既定の送り先へ送ります。ショートカット App で送り先を指定したものは、既定を変えてもその送り先のままです。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإرسال عبر Siri، يُرسل إلى الوجهة الافتراضية إن لم تحدد وجهة. أما ما حددت وجهته في تطبيق «الاختصارات» فتبقى وجهته حتى لو غيّرت الافتراضية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri দিয়ে পাঠানোর সময় গন্তব্য না বললে ডিফল্ট গন্তব্যে যায়। শর্টকাট অ্যাপে গন্তব্য ঠিক করা থাকলে ডিফল্ট বদলালেও সেটিই থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan envies amb Siri, si no has indicat cap destí s’utilitza el destí per defecte. Si has definit un destí a l’app Dreceres, es manté aquest encara que canviïs el per defecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při odesílání přes Siri bez zadaného příjemce se použije výchozí příjemce. Příjemce zadaný v aplikaci Zkratky zůstane i po změně výchozího."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du sender med Siri uden at angive et mål, bruges standardmålet. Et mål, du har angivet i appen Genveje, bevares, selv om du ændrer standardmålet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du mit Siri sendest und kein Ziel nennst, geht es an das Standardziel. Hast du in der Kurzbefehle-App ein Ziel festgelegt, bleibt es dabei, auch wenn du das Standardziel änderst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν στέλνετε με το Siri, αν δεν ορίσετε προορισμό, χρησιμοποιείται ο προεπιλεγμένος. Ο προορισμός που ορίζεται στην εφαρμογή Συντομεύσεις παραμένει ακόμη κι αν αλλάξετε την προεπιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you send with Siri without naming a destination, it goes to your default destination. If you chose a destination in the Shortcuts app, it stays that one even if you change the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si envías con Siri sin indicar un destino, se envía al destino predeterminado. Si elegiste un destino en la app Atajos, se mantiene aunque cambies el predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun lähetät Sirillä ilman kohdetta, käytetään oletuskohdetta. Pikakomennot-apissa määritetty kohde pysyy samana, vaikka vaihtaisit oletuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous envoyez avec Siri sans préciser de destination, le message va à la destination par défaut. Si vous avez choisi une destination dans l’app Raccourcis, elle reste la même même si vous changez la destination par défaut."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri થી મોકલતી વખતે ગંતવ્ય ન કહો તો ડિફૉલ્ટ ગંતવ્યમાં જાય છે. શૉર્ટકટ્સ ઍપમાં ગંતવ્ય નક્કી કર્યું હોય તો ડિફૉલ્ટ બદલવા છતાં તે જ રહે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשליחה עם Siri, אם לא צוין יעד, ההודעה נשלחת ליעד ברירת המחדל. פעולה שיעדה נקבע באפליקציית “קיצורי דרך” נשארת עם אותו יעד גם אם משנים את ברירת המחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri से भेजते समय मंज़िल न बताई हो तो डिफ़ॉल्ट मंज़िल पर जाता है। शॉर्टकट ऐप में जिसकी मंज़िल तय की गई हो, डिफ़ॉल्ट बदलने पर भी वही मंज़िल रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri slanju sa Siri koristi se zadano odredište ako ga ne navedete. Odredište zadano u aplikaciji Prečaci ostaje, čak i ako promijenite zadano."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirivel küldéskor az alapértelmezett cél kapja az üzenetet, ha nem ad meg másikat. A Parancsok appban megadott cél az alapértelmezett módosítása után is megmarad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat mengirim dengan Siri tanpa menentukan tujuan, pesan dikirim ke tujuan default. Jika tujuan ditentukan di app Pintasan, tujuan itu tetap dipakai meski default diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se invii con Siri senza indicare una destinazione, l’invio va alla destinazione predefinita. Se hai scelto una destinazione nell’app Comandi rapidi, resta quella anche se cambi la predefinita."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ಮೂಲಕ ಕಳುಹಿಸುವಾಗ ಗಮ್ಯಸ್ಥಾನ ಹೇಳದಿದ್ದರೆ ಡಿಫಾಲ್ಟ್ ಗಮ್ಯಸ್ಥಾನಕ್ಕೆ ಹೋಗುತ್ತದೆ. ಶಾರ್ಟ್‌ಕಟ್ಸ್ ಆ್ಯಪ್‌ನಲ್ಲಿ ಗಮ್ಯಸ್ಥಾನ ಆರಿಸಿದ್ದರೆ ಡಿಫಾಲ್ಟ್ ಬದಲಾದರೂ ಅದೇ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri로 보낼 때 전송 대상을 지정하지 않으면 기본 전송 대상으로 보냅니다. 단축어 앱에서 전송 대상을 지정한 경우에는 기본 대상을 바꿔도 그 대상으로 보냅니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri വഴി അയയ്ക്കുമ്പോൾ ലക്ഷ്യം പറഞ്ഞില്ലെങ്കിൽ ഡിഫോൾട്ട് ലക്ഷ്യത്തിലേക്ക് പോകും. ഷോർട്ട്കട്ട്സ് ആപ്പിൽ ലക്ഷ്യം തിരഞ്ഞെടുത്തിട്ടുണ്ടെങ്കിൽ ഡിഫോൾട്ട് മാറ്റിയാലും അത് തന്നെ തുടരും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ने पाठवताना गंतव्य सांगितले नाही तर डीफॉल्ट गंतव्यावर जाते. शॉर्टकट्स ॲपमध्ये गंतव्य निवडले असल्यास डीफॉल्ट बदलला तरी तेच राहते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila menghantar dengan Siri tanpa menetapkan destinasi, destinasi lalai digunakan. Destinasi yang ditetapkan dalam apl Pintasan kekal walaupun anda menukar lalai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du sender med Siri uten å angi mål, brukes standardmålet. Et mål du har angitt i Snarveier-appen blir stående, selv om du endrer standardmålet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij versturen met Siri wordt de standaardbestemming gebruikt als je geen bestemming opgeeft. Heb je in de Opdrachten-app een bestemming ingesteld, dan blijft die gelden, ook als je de standaard wijzigt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ରେ ପଠାଇବାବେଳେ ଗନ୍ତବ୍ୟ ନ ଦେଇଥିଲେ ଡିଫଲ୍ଟ ଗନ୍ତବ୍ୟକୁ ଯିବ। ଶର୍ଟକଟ୍ସ ଆପ୍ ରେ ଗନ୍ତବ୍ୟ ଦେଇଥିଲେ, ଡିଫଲ୍ଟ ବଦଳାଇଲେ ବି ତାହା ବଦଳିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ਨਾਲ ਭੇਜਦੇ ਸਮੇਂ ਮੰਜ਼ਿਲ ਨਾ ਦੱਸੀ ਹੋਵੇ ਤਾਂ ਮੂਲ ਮੰਜ਼ਿਲ ’ਤੇ ਜਾਵੇਗਾ। ਸ਼ਾਰਟਕੱਟ ਐਪ ਵਿੱਚ ਮੰਜ਼ਿਲ ਦੱਸੀ ਹੋਵੇ ਤਾਂ ਮੂਲ ਬਦਲਣ ’ਤੇ ਵੀ ਉਹੀ ਰਹੇਗੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wysyłaniu przez Siri bez wskazanego odbiorcy używany jest odbiorca domyślny. Odbiorca wskazany w aplikacji Skróty nie zmieni się po zmianie domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao enviar com a Siri, se nenhum destino foi indicado, é usado o destino padrão. Se você definiu um destino no app Atalhos, ele continua o mesmo, mesmo que o padrão mude."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao enviar com a Siri, se não indicar um destino, é usado o destino padrão. Se definiu um destino na app Atalhos, este mantém-se, mesmo que altere o padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când trimiți cu Siri, dacă nu ai indicat o destinație, se folosește cea implicită. Dacă ai setat o destinație în aplicația Comenzi rapide, aceasta rămâne aceeași chiar dacă schimbi destinația implicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При отправке через Siri без указанного получателя используется получатель по умолчанию. Если получатель задан в приложении «Быстрые команды», он не изменится при смене получателя по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri odosielaní cez Siri bez zadaného príjemcu sa použije predvolený príjemca. Príjemca zadaný v aplikácii Skratky zostane aj po zmene predvoleného."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri pošiljanju s Siri se uporabi privzeti cilj, če ga ne določite. Cilj, določen v aplikaciji Bližnjice, ostane, tudi če spremenite privzetega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du skickar med Siri och inget mål anges används standardmålet. Om du har angett ett mål i appen Genvägar ligger det kvar även om du ändrar standardmålet."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri மூலம் அனுப்பும்போது சேருமிடம் குறிப்பிடாவிட்டால் இயல்புநிலை சேருமிடத்துக்குச் செல்லும். ஷார்ட்கட்ஸ் ஆப்பில் சேருமிடம் குறிப்பிட்டிருந்தால், இயல்புநிலையை மாற்றினாலும் அதுவே நீடிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri తో పంపేటప్పుడు గమ్యం పేర్కొనకపోతే డిఫాల్ట్ గమ్యానికి వెళ్తుంది. షార్ట్‌కట్‌లు యాప్‌లో గమ్యం పేర్కొంటే, డిఫాల్ట్ మార్చినా అదే ఉంటుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อส่งด้วย Siri โดยไม่ได้ระบุปลายทาง จะส่งไปยังปลายทางเริ่มต้น หากระบุปลายทางในแอปคำสั่งลัด ก็จะส่งไปที่นั่นเสมอแม้เปลี่ยนค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ile gönderirken hedef belirtmezseniz varsayılan hedefe gönderilir. Kısayollar uygulamasında hedef belirtilmişse, varsayılanı değiştirseniz de o hedef kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час надсилання через Siri без указаного отримувача використовується отримувач за замовчуванням. Якщо отримувача задано в застосунку «Команди», він не зміниться після зміни отримувача за замовчуванням."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri سے بھیجتے وقت منزل نہ بتائی ہو تو ڈیفالٹ منزل پر جاتا ہے۔ شارٹ کٹس ایپ میں جس میں منزل مقرر کی گئی ہو، ڈیفالٹ بدلنے پر بھی وہی منزل رہتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi gửi bằng Siri mà không chỉ định nơi nhận, tin sẽ gửi tới nơi nhận mặc định. Nếu bạn chỉ định nơi nhận trong ứng dụng Phím tắt, tin vẫn gửi tới đó dù đổi mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Siri 发送时，如果没有指定发送目标，将发送到默认发送目标。在快捷指令 App 中指定了发送目标的，即使更改默认目标，仍会发送到该目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Siri 傳送時，若未指定傳送目的地，會傳送到預設目的地。在「捷徑」App 中指定了目的地的項目，即使變更預設也會維持該目的地。"
          }
        }
      }
    },
