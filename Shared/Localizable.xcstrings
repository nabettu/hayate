    "送り先の URL と認証ヘッダは、iPhone と Apple Watch の Keychain にだけ保存します。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ عنوان URL وترويسة المصادقة للوجهة في Keychain على iPhone وApple Watch فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গন্তব্যের URL ও অথেনটিকেশন হেডার শুধু iPhone ও Apple Watch-এর Keychain-এ সংরক্ষিত থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL i la capçalera d’autenticació del destí només es desen al Keychain de l’iPhone i de l’Apple Watch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL a ověřovací záhlaví příjemce se ukládají jen do Keychain v iPhonu a Apple Watch."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målets URL og godkendelsesheadere gemmes kun i Keychain på iPhone og Apple Watch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL und Authentifizierungs-Header eines Ziels werden nur im Schlüsselbund (Keychain) von iPhone und Apple Watch gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το URL του προορισμού και οι κεφαλίδες ταυτοποίησης αποθηκεύονται μόνο στο Keychain του iPhone και του Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destination URLs and authentication headers are stored only in the Keychain on iPhone and Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL y los encabezados de autenticación de un destino se guardan solo en el Keychain del iPhone y del Apple Watch."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteen URL ja todennusotsikot tallennetaan vain iPhonen ja Apple Watchin Keychainiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL et les en-têtes d’authentification d’une destination sont stockés uniquement dans le Keychain de l’iPhone et de l’Apple Watch."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ગંતવ્યનો URL અને ઑથેન્ટિકેશન હેડર ફક્ત iPhone અને Apple Watch ના Keychain માં સાચવાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
