          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke modtage indstillinger fra iPhone"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen konnten nicht vom iPhone empfangen werden"
