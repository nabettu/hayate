          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험이 끝나면 Apple Watch, Siri, iPhone의 \"보내기\" 탭에서 보낼 수 없습니다(전송 대상 테스트 전송 포함). 전송 대상 등록과 기록 확인은 계속 사용할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
