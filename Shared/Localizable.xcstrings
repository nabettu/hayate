        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan registrere godkendelsesheadere som Authorization. Værdierne gemmes kun i Keychain på iPhone og Apple Watch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Authentifizierungs-Header wie Authorization hinzufügen. Die Werte werden nur im Schlüsselbund (Keychain) von iPhone und Apple Watch gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να καταχωρίσετε κεφαλίδες ταυτοποίησης, όπως Authorization. Οι τιμές αποθηκεύονται μόνο στο Keychain του iPhone και του Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add authentication headers such as Authorization. Values are stored only in the Keychain on iPhone and Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir encabezados de autenticación como Authorization. Los valores se guardan solo en el Keychain del iPhone y del Apple Watch."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit rekisteröidä todennusotsikoita, kuten Authorization. Arvot tallennetaan vain iPhonen ja Apple Watchin Keychainiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter des en-têtes d’authentification comme Authorization. Les valeurs sont stockées uniquement dans le Keychain de l’iPhone et de l’Apple Watch."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization જેવા ઑથેન્ટિકેશન હેડર ઉમેરી શકાય છે. કિંમત ફક્ત iPhone અને Apple Watch ના Keychain માં સાચવાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לרשום כותרות אימות כמו Authorization. הערך נשמר רק ב-Keychain ב-iPhone וב-Apple Watch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization जैसे प्रमाणीकरण हेडर दर्ज किए जा सकते हैं। वैल्यू सिर्फ़ iPhone और Apple Watch की Keychain में सहेजी जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možete registrirati zaglavlja za autentifikaciju, poput Authorization. Vrijednosti se spremaju samo u Keychain na iPhoneu i Apple Watchu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitelesítési fejléceket (pl. Authorization) adhat meg. Az értékek csak az iPhone és az Apple Watch Keychainjében tárolódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mendaftarkan header autentikasi seperti Authorization. Nilainya hanya disimpan di Keychain iPhone dan Apple Watch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere header di autenticazione come Authorization. I valori vengono salvati solo nel Keychain di iPhone e Apple Watch."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization ನಂತಹ ದೃಢೀಕರಣ ಹೆಡರ್‌ಗಳನ್ನು ಸೇರಿಸಬಹುದು. ಮೌಲ್ಯವನ್ನು iPhone ಮತ್ತು Apple Watch ನ Keychain ನಲ್ಲಿ ಮಾತ್ರ ಉಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization 같은 인증 헤더를 등록할 수 있습니다. 값은 iPhone과 Apple Watch의 Keychain에만 저장됩니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization പോലുള്ള ആധികാരികത ഹെഡറുകൾ ചേർക്കാം. മൂല്യം iPhone ന്റെയും Apple Watch ന്റെയും Keychain ൽ മാത്രം സൂക്ഷിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization सारखे ऑथेंटिकेशन हेडर नोंदवता येतात. मूल्य फक्त iPhone आणि Apple Watch च्या Keychain मध्ये साठवले जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh mendaftarkan pengepala pengesahan seperti Authorization. Nilai hanya disimpan dalam Keychain pada iPhone dan Apple Watch."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan registrere autentiseringsheadere som Authorization. Verdiene lagres bare i Keychain på iPhone og Apple Watch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt authenticatieheaders zoals Authorization toevoegen. De waarden worden alleen opgeslagen in de Keychain van de iPhone en de Apple Watch."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization ଭଳି ପ୍ରମାଣୀକରଣ ହେଡର୍ ଯୋଡ଼ିପାରିବେ। ମୂଲ୍ୟ କେବଳ iPhone ଓ Apple Watch ର Keychain ରେ ସଞ୍ଚିତ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization ਵਰਗੇ ਪ੍ਰਮਾਣੀਕਰਨ ਹੈਡਰ ਜੋੜ ਸਕਦੇ ਹੋ। ਮੁੱਲ ਸਿਰਫ਼ iPhone ਅਤੇ Apple Watch ਦੀ Keychain ਵਿੱਚ ਸੰਭਾਲੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dodać nagłówki uwierzytelniania, np. Authorization. Wartości są zapisywane tylko w Keychain na iPhonie i Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode cadastrar cabeçalhos de autenticação, como Authorization. Os valores ficam salvos apenas no Keychain do iPhone e do Apple Watch."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode registar cabeçalhos de autenticação, como Authorization. Os valores ficam guardados apenas no Keychain do iPhone e do Apple Watch."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți înregistra antete de autentificare, precum Authorization. Valorile se salvează doar în Keychain pe iPhone și pe Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно добавить заголовки авторизации, например Authorization. Значения хранятся только в Keychain на iPhone и Apple Watch."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môžete pridať overovacie hlavičky, napríklad Authorization. Hodnoty sa ukladajú iba do Keychain v iPhone a Apple Watch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrirate lahko overitvene glave, na primer Authorization. Vrednosti so shranjene samo v Keychain v iPhonu in Apple Watch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan registrera autentiseringsrubriker som Authorization. Värdena sparas bara i Keychain på iPhone och Apple Watch."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization போன்ற அங்கீகார ஹெடர்களைப் பதிவு செய்யலாம். மதிப்புகள் iPhone மற்றும் Apple Watch இன் Keychain இல் மட்டுமே சேமிக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization వంటి ధృవీకరణ హెడర్‌లను నమోదు చేయవచ్చు. విలువలు iPhone, Apple Watch Keychain లో మాత్రమే నిల్వ అవుతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณลงทะเบียนเฮดเดอร์สำหรับยืนยันตัวตน เช่น Authorization ได้ ค่าจะถูกเก็บไว้ใน Keychain ของ iPhone และ Apple Watch เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization gibi kimlik doğrulama başlıkları kaydedebilirsiniz. Değerler yalnızca iPhone ve Apple Watch’taki Keychain’de saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна додати заголовки авторизації, наприклад Authorization. Значення зберігаються лише в Keychain на iPhone та Apple Watch."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorization جیسے تصدیقی ہیڈر درج کیے جا سکتے ہیں۔ ویلیو صرف iPhone اور Apple Watch کے Keychain میں محفوظ ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đăng ký header xác thực như Authorization. Giá trị chỉ được lưu trong Keychain của iPhone và Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以登记 Authorization 等认证请求头。值只保存在 iPhone 和 Apple Watch 的 Keychain 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可登錄 Authorization 等驗證標頭。值只會儲存在 iPhone 與 Apple Watch 的 Keychain。"
          }
        }
      }
