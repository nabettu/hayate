    "iPhone の「Watch」アプリ →「マイウォッチ」の文字盤 → コンプリケーションでも設定できます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا الضبط من تطبيق «Watch» على iPhone ← «ساعتي» ← وجه الساعة ← التعقيدات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
