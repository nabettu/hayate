        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a nota começar com uma palavra-chave, como “Lembrete, comprar leite”, “comprar leite” (sem a palavra-chave) é adicionado aos Lembretes."
