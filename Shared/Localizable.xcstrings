          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al termine della prova non potrai più inviare da Apple Watch, Siri o dalla scheda “Invia” di iPhone (nemmeno gli invii di prova). Potrai comunque registrare destinazioni e consultare la cronologia."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
