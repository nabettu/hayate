    "iPhone から設定を受け取れませんでした" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر استلام الإعدادات من iPhone"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone থেকে সেটিংস পাওয়া যায়নি"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut rebre la configuració de l’iPhone"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení se nepodařilo přijmout z iPhonu"
