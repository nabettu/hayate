    "デジタルクラウンを回すか下へスクロールすると、直近 50 件のメモと送った結果を見られます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر التاج الرقمي أو مرّر لأسفل لرؤية آخر 50 ملاحظة ونتائج إرسالها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিজিটাল ক্রাউন ঘোরান বা নিচে স্ক্রল করে সর্বশেষ ৫০টি মেমো ও পাঠানোর ফলাফল দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la Digital Crown o desplaça cap avall per veure les últimes 50 notes i el resultat de l’enviament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otočením Digital Crown nebo posunem dolů zobrazíte posledních 50 poznámek a výsledky odeslání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej på Digital Crown, eller rul ned for at se de seneste 50 noter og resultatet af afsendelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe die Digital Crown oder scrolle nach unten, um die letzten 50 Notizen und die Ergebnisse des Sendens zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γυρίστε το Digital Crown ή κάντε κύλιση προς τα κάτω για να δείτε τις τελευταίες 50 σημειώσεις και το αποτέλεσμα της αποστολής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn the Digital Crown or scroll down to see the latest 50 memos and their results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la corona digital o desplázate hacia abajo para ver las últimas 50 notas y el resultado del envío."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännä Digital Crownia tai vieritä alas nähdäksesi viimeiset 50 muistiinpanoa ja lähetyksen tulokset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez la Digital Crown ou faites défiler vers le bas pour voir les 50 derniers mémos et leur résultat d’envoi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ડિજિટલ ક્રાઉન ફેરવો અથવા નીચે સ્ક્રોલ કરો તો છેલ્લી 50 નોંધ અને મોકલવાનું પરિણામ જોઈ શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סובבו את ה-Digital Crown או גללו למטה כדי לראות את 50 ההערות האחרונות ואת תוצאת השליחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिजिटल क्राउन घुमाएँ या नीचे स्क्रोल करें, तो पिछले 50 नोट और भेजने का नतीजा दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavrtite Digital Crown ili se pomaknite prema dolje da vidite posljednjih 50 bilješki i rezultat slanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgassa a Digital Crownt, vagy görgessen lefelé: megjelenik az utolsó 50 jegyzet és a küldés eredménye."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar Digital Crown atau gulir ke bawah untuk melihat 50 catatan terbaru beserta hasil pengiriman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota la Digital Crown o scorri verso il basso per vedere gli ultimi 50 appunti e l’esito dell’invio."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡಿಜಿಟಲ್ ಕ್ರೌನ್ ತಿರುಗಿಸಿ ಅಥವಾ ಕೆಳಗೆ ಸ್ಕ್ರಾಲ್ ಮಾಡಿದರೆ ಇತ್ತೀಚಿನ 50 ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ಕಳುಹಿಸಿದ ಫಲಿತಾಂಶ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Crown을 돌리거나 아래로 스크롤하면 최근 메모 50개와 전송 결과를 볼 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Crown തിരിക്കുകയോ താഴേക്ക് സ്ക്രോൾ ചെയ്യുകയോ ചെയ്താൽ ഏറ്റവും പുതിയ 50 മെമ്മോകളും അയച്ച ഫലവും കാണാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Crown फिरवा किंवा खाली स्क्रोल करा, म्हणजे अलीकडील 50 मेमो आणि पाठवण्याचा निकाल दिसेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar Digital Crown atau tatal ke bawah untuk melihat 50 memo terkini dan hasil penghantaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Digital Crown eller rull ned for å se de siste 50 memoene og resultatet av sendingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai aan de Digital Crown of scrol omlaag om de laatste 50 memo’s en het resultaat van het versturen te zien."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଡିଜିଟାଲ୍ କ୍ରାଉନ୍ ଘୁରାନ୍ତୁ ବା ତଳକୁ ସ୍କ୍ରୋଲ୍ କରନ୍ତୁ, ଶେଷ 50 ଟି ନୋଟ୍ ଓ ପଠାଣ ଫଳାଫଳ ଦେଖିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਡਿਜੀਟਲ ਕਰਾਊਨ ਘੁੰਮਾਓ ਜਾਂ ਹੇਠਾਂ ਸਕ੍ਰੋਲ ਕਰੋ, ਤਾਜ਼ਾ 50 ਨੋਟ ਅਤੇ ਭੇਜਣ ਦੇ ਨਤੀਜੇ ਦੇਖ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obróć Digital Crown lub przewiń w dół, aby zobaczyć 50 ostatnich notatek i wyniki wysyłki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire a Digital Crown ou role para baixo para ver as 50 anotações mais recentes e os resultados do envio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rode a Digital Crown ou desloque para baixo para ver as 50 notas mais recentes e os resultados do envio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotește Digital Crown sau derulează în jos pentru a vedea ultimele 50 de notițe și rezultatul trimiterii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрутите Digital Crown или прокрутите вниз, чтобы увидеть последние 50 заметок и результат отправки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otočte Digital Crown alebo posuňte nadol, aby ste videli posledných 50 poznámok a výsledok odoslania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavrtite Digital Crown ali se pomaknite navzdol, da vidite zadnjih 50 zapiskov in rezultat pošiljanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrid på Digital Crown eller scrolla ned för att se de senaste 50 anteckningarna och resultatet av sändningen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "டிஜிட்டல் கிரவுனைச் சுழற்றுங்கள் அல்லது கீழே ஸ்க்ரோல் செய்யுங்கள். சமீபத்திய 50 குறிப்புகளையும் அனுப்பிய முடிவுகளையும் பார்க்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "డిజిటల్ క్రౌన్ తిప్పండి లేదా కిందికి స్క్రోల్ చేయండి. ఇటీవలి 50 నోట్స్, పంపిన ఫలితాలు చూడవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมุน Digital Crown หรือเลื่อนลงเพื่อดูบันทึก 50 รายการล่าสุดและผลการส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Crown’u çevirerek veya aşağı kaydırarak son 50 notu ve gönderim sonuçlarını görebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поверніть Digital Crown або прокрутіть униз, щоб побачити останні 50 нотаток і результати надсилання."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digital Crown گھمائیں یا نیچے اسکرول کریں تو حالیہ 50 نوٹس اور بھیجنے کے نتائج نظر آتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoay Digital Crown hoặc cuộn xuống để xem 50 ghi chú gần nhất và kết quả gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转动数码表冠或向下滚动，可查看最近 50 条备忘和发送结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉動數位錶冠或向下捲動，可查看最近 50 則備忘和傳送結果。"
          }
        }
      }
    },
