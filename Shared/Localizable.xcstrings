        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavit to lze i v aplikaci „Watch“ v iPhonu: „Moje hodinky“ → ciferník → komplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan også indstille det i appen »Watch« på iPhone → urskiven under »Mit ur« → komplikation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst es auch in der Watch-App auf dem iPhone einstellen: „Meine Watch“, dann ein Zifferblatt wählen und Komplikationen festlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να το ορίσετε και στο iPhone: εφαρμογή «Watch» → πρόσοψη στο «Το ρολόι μου» → complication."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also set this up in the Watch app on iPhone: My Watch, then choose a watch face and set up complications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes configurarlo en la app Watch del iPhone: “Mi reloj”, elige una esfera y configura las complicaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit asettaa sen myös iPhonen ”Watch”-apissa → ”Oma kello” -kellotaulu → komplikaatio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi régler cela dans l’app Watch de l’iPhone : « Ma montre », puis choisissez un cadran et réglez les complications."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ની “Watch” ઍપ → “મારી વૉચ” ના વૉચ ફેસ → કૉમ્પ્લિકેશનમાંથી પણ સેટ કરી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להגדיר גם באפליקציית “Watch” ב-iPhone ← “השעון שלי” ← תצוגת השעון ← קומפליקציות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone की “Watch” ऐप → “मेरी वॉच” → वॉच फ़ेस → कॉम्प्लिकेशन में भी सेट कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaviti možete i na iPhoneu: aplikacija „Watch” → brojčanik u „Moj sat” → komplikacija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítható az iPhone „Watch” appjában is: „Saját óra” → számlap → komplikáció."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisa juga diatur di app \"Watch\" di iPhone → tampilan jam di \"Jam Saya\" → komplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi impostarlo anche nell’app Watch su iPhone: “Il mio Watch”, scegli un quadrante e imposta le complicazioni."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ನ “Watch” ಆ್ಯಪ್ → “ಮೈ ವಾಚ್” ನ ವಾಚ್ ಫೇಸ್ → ಕಾಂಪ್ಲಿಕೇಶನ್‌ನಿಂದಲೂ ಹೊಂದಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 \"Watch\" 앱 → \"나의 시계\"의 시계 페이스 → 컴플리케이션에서도 설정할 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ലെ “Watch” ആപ്പ് → “എന്റെ വാച്ച്” ലെ വാച്ച് ഫേസ് → കോംപ്ലിക്കേഷനിൽ നിന്നും സജ്ജമാക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone चे “Watch” ॲप → “माझे वॉच” मधील वॉच फेस → कॉम्प्लिकेशनमधूनही सेट करता येते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda juga boleh menetapkannya dalam apl “Watch” pada iPhone → wajah jam di bawah “Jam Saya” → komplikasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan også stille det inn i «Watch»-appen på iPhone → urskiven under «Min klokke» → komplikasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt het ook instellen in de “Watch”-app op de iPhone → “Mijn horloge” → wijzerplaat → complicatie."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ର “Watch” ଆପ୍ → “My Watch” ର ୱାଚ୍ ଫେସ୍ → କମ୍ପ୍ଲିକେସନ୍ ରୁ ମଧ୍ୟ ସେଟ୍ କରିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ਦੀ “Watch” ਐਪ → “My Watch” ਦੇ ਵਾਚ ਫੇਸ → ਕੰਪਲੀਕੇਸ਼ਨ ਤੋਂ ਵੀ ਸੈੱਟ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz to ustawić też w aplikacji „Watch” na iPhonie: „Mój zegarek” → tarcza → komplikacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também dá para configurar no app “Watch” do iPhone → “Meu Relógio” → mostrador → complicação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também é possível configurar na app “Watch” do iPhone → “Meu Relógio” → mostrador → complicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți configura și din aplicația „Watch” de pe iPhone → „Ceasul meu” → cadran → complicație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроить можно и в приложении «Watch» на iPhone: «Мои часы» → циферблат → компликации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaviť to možno aj v aplikácii „Watch“ v iPhone: „Moje hodinky“ → ciferník → komplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite lahko tudi v iPhonu: aplikacija »Watch« → številčnica v »Moja ura« → komplikacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan också ställa in det i appen ”Watch” på iPhone → urtavlan under ”Min klocka” → komplikation."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone இன் “Watch” ஆப் → “My Watch” இன் வாட்ச் ஃபேஸ் → காம்ப்ளிகேஷன் வழியாகவும் அமைக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone లోని “Watch” యాప్ → “My Watch” లోని వాచ్ ఫేస్ → కాంప్లికేషన్ నుండి కూడా సెట్ చేయవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าได้ที่แอป \"Watch\" บน iPhone → หน้าปัดใน \"นาฬิกาของฉัน\" → คอมพลิเคชัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’daki “Watch” uygulaması → “Saatim” altındaki kadran → komplikasyon bölümünden de ayarlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштувати можна й у застосунку «Watch» на iPhone: «Мій годинник» → циферблат → комплікації."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone کی “Watch” ایپ ← “میری گھڑی” ← واچ فیس ← کمپلیکیشنز میں بھی سیٹ کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cũng có thể cài đặt trong ứng dụng \"Watch\" trên iPhone → mặt đồng hồ trong \"Đồng hồ của tôi\" → complication."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以在 iPhone 的“Watch”App →“我的手表”的表盘 → 复杂功能 中设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以在 iPhone 的「Watch」App →「我的手錶」的錶面 → 複雜功能中設定。"
          }
        }
      }
