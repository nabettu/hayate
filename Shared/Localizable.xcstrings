        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備忘的開頭符合任一觸發詞時，會加入提醒事項。不區分大小寫和全形半形。只有觸發詞而沒有內文時，只保留為備忘。"
          }
        }
      }
