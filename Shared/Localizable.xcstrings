          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक संदेशाचा ID. पुन्हा पाठवला तरी तोच, त्यामुळे डुप्लिकेट काढण्यासाठी वापरता येतो"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID bagi setiap mesej. Sama apabila dihantar semula, jadi boleh digunakan untuk membuang pendua"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID per melding. Samme ved ny sending, så den kan brukes til å fjerne duplikater"
