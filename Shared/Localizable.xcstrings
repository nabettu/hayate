    "タップすると Hayate が開き、すぐ「送る」を押せます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الضغط يُفتح Hayate ويمكنك الضغط على «إرسال» فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্যাপ করলে Hayate খুলবে এবং সঙ্গে সঙ্গে “পাঠান” চাপতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca per obrir Hayate i prémer «Envia» a l’instant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po klepnutí se otevře Hayate a hned můžete stisknout „Odeslat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk, så åbnes Hayate, og du kan straks trykke på »Send«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um Hayate zu öffnen und sofort „Senden“ zu drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
