          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista ennen tallennusta ”Lähetä testi” -toiminnolla, että kanavalle ilmestyy ”Tämä on Hayaten testiviesti”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d’enregistrer, touchez « Envoi de test » et vérifiez que « Ceci est un test de Hayate » apparaît dans le salon."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સાચવતા પહેલાં “ટેસ્ટ મોકલો” થી તપાસો કે ચેનલમાં “આ Hayate નો ટેસ્ટ સંદેશ છે” આવે છે કે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפני השמירה, לחצו “שליחת בדיקה” וודאו שבערוץ מופיע “זו שליחת בדיקה מ-Hayate”."
          }
        },
        "hi" : {
          "stringUnit" : {
