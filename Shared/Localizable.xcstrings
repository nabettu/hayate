        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår »Skjul som hemmelig værdi« til, vises værdien som prikker. Værdien gemmes kun i Keychain på iPhone og uret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist „Als geheimen Wert ausblenden“ aktiviert, wird der Wert auf dem Bildschirm verdeckt. Die Werte werden nur im Schlüsselbund (Keychain) von iPhone und Watch gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ενεργοποιήσετε το «Απόκρυψη ως μυστική τιμή», οι τιμές εμφανίζονται κρυμμένες στην οθόνη. Οι τιμές αποθηκεύονται μόνο στο Keychain του iPhone και του ρολογιού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on “Hide as Secret Value” to mask it on screen. Values are stored only in the Keychain on iPhone and Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activas “Ocultar como valor secreto”, el valor aparece oculto en pantalla. Los valores se guardan solo en el Keychain del iPhone y del reloj."
          }
