        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಳಿಸುವ ಮೊದಲು “ಟೆಸ್ಟ್ ಕಳುಹಿಸಿ” ಮೂಲಕ ಚಾನಲ್‌ಗೆ ತಲುಪುತ್ತದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하기 전에 \"테스트 전송\"으로 채널에 도착하는지 확인하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സേവ് ചെയ്യുന്നതിന് മുമ്പ് “ടെസ്റ്റ് അയയ്ക്കുക” ഉപയോഗിച്ച് ചാനലിൽ എത്തുന്നുണ്ടോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव्ह करण्यापूर्वी “टेस्ट पाठवा” ने चॅनेलवर पोहोचते का ते तपासा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum menyimpan, gunakan “Hantar ujian” dan semak sama ada mesej sampai ke saluran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du lagrer: bruk «Send test», og sjekk at det kommer fram til kanalen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuur vóór het bewaren een testbericht en controleer of het in het kanaal aankomt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଭ୍ କରିବା ପୂର୍ବରୁ “ଟେଷ୍ଟ ପଠାଣ” ଦ୍ୱାରା ଚ୍ୟାନେଲରେ ପହଞ୍ଚୁଛି କି ଯାଞ୍ଚ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੰਭਾਲਣ ਤੋਂ ਪਹਿਲਾਂ “ਟੈਸਟ ਭੇਜੋ” ਨਾਲ ਚੈਨਲ ਵਿੱਚ ਪਹੁੰਚਦਾ ਹੈ ਜਾਂ ਨਹੀਂ, ਇਹ ਦੇਖੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed zapisem wyślij „Wiadomość testowa” i sprawdź, czy dotarła na kanał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de salvar, use “Enviar teste” e confira se a mensagem chega ao canal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de guardadar, use “Enviar teste” e confira se a mensagem chega ao canal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte de salvare, fă o trimitere de test și verifică dacă ajunge pe canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сохранением нажмите «Тестовая отправка» и убедитесь, что сообщение дошло до канала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred uložením vyskúšajte „Skúšobné odoslanie“ a overte, že správa dorazila do kanála."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred shranjevanjem s »Testnim pošiljanjem« preverite, ali sporočilo prispe v kanal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du sparar: använd ”Skicka test” och kontrollera att det kommer fram till kanalen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமிக்கும் முன் “சோதனை அனுப்புதல்” மூலம் சேனலுக்கு வந்து சேர்கிறதா எனச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసే ముందు “టెస్ట్ పంపకం” తో ఛానెల్‌కు చేరుతోందో చూడండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนบันทึก ให้กด \"ส่งทดสอบ\" และตรวจสอบว่าข้อความไปถึงช่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
