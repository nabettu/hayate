        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଘଡ଼ିର ୱାଚ୍ ଫେସ୍ କୁ ଦୀର୍ଘ ସମୟ ଦବାନ୍ତୁ → “Edit” → କମ୍ପ୍ଲିକେସନ୍ ସ୍ଲଟ୍ ବାଛନ୍ତୁ → ତାଲିକାର “Hayate” ରୁ ଆକାର ବାଛନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘੜੀ ਦੇ ਵਾਚ ਫੇਸ ਨੂੰ ਦੇਰ ਤੱਕ ਦਬਾਓ → “ਸੰਪਾਦਨ” → ਕੰਪਲੀਕੇਸ਼ਨ ਦੀ ਥਾਂ ਚੁਣੋ → ਸੂਚੀ ਦੇ “Hayate” ਵਿੱਚੋਂ ਸ਼ਕਲ ਚੁਣੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj tarczę zegarka → „Edytuj” → wybierz miejsce komplikacji i „Hayate” z listy → wybierz kształt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o mostrador pressionado → “Editar” → escolha o espaço da complicação e selecione um formato em “Hayate” na lista."
          }
        },
