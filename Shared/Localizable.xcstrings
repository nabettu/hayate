          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ کرنے سے پہلے “ٹیسٹ ارسال” دبائیں اور دیکھیں کہ چینل میں پہنچا یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
