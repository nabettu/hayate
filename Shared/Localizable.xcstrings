    "20 秒で応答が無ければ時間切れとして送り直します。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يصل رد خلال 20 ثانية، تُعدّ المهلة منتهية ويُعاد الإرسال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "২০ সেকেন্ডে সাড়া না এলে টাইমআউট ধরে আবার পাঠানো হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hi ha resposta en 20 segons, es considera que s’ha esgotat el temps i es torna a enviar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud odpověď nepřijde do 20 sekund, požadavek se považuje za vypršelý a odešle se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis der ikke kommer svar inden for 20 sekunder, tæller det som timeout og sendes igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt nach 20 Sekunden keine Antwort, gilt das als Zeitüberschreitung und wird erneut gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν υπάρξει απάντηση σε 20 δευτερόλεπτα, θεωρείται λήξη χρόνου και η αποστολή επαναλαμβάνεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there’s no response in 20 seconds, it’s treated as a timeout and sent again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay respuesta en 20 segundos, se considera agotado el tiempo y se vuelve a enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos vastausta ei tule 20 sekunnissa, se katsotaan aikakatkaisuksi ja lähetetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans réponse après 20 secondes, l’envoi est considéré comme expiré et sera relancé."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 સેકન્ડમાં જવાબ ન આવે તો ટાઇમઆઉટ ગણીને ફરી મોકલાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם אין תגובה תוך 20 שניות, הבקשה נחשבת כפגת זמן ונשלחת מחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 सेकंड में जवाब न आए तो उसे टाइमआउट मानकर दोबारा भेजा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako nema odgovora u 20 sekundi, računa se kao istek vremena i šalje se ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha 20 másodpercen belül nincs válasz, időtúllépésnek számít, és újraküldi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak ada respons dalam 20 detik, dianggap habis waktu dan dikirim ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non c’è risposta entro 20 secondi, l’invio scade e viene ritentato."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 ಸೆಕೆಂಡ್‌ನಲ್ಲಿ ಪ್ರತಿಕ್ರಿಯೆ ಬರದಿದ್ದರೆ ಟೈಮ್‌ಔಟ್ ಎಂದು ಪರಿಗಣಿಸಿ ಮತ್ತೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20초 안에 응답이 없으면 시간 초과로 보고 다시 보냅니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 സെക്കൻഡിൽ മറുപടി ലഭിച്ചില്ലെങ്കിൽ ടൈംഔട്ടായി കണക്കാക്കി വീണ്ടും അയയ്ക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 सेकंदांत प्रतिसाद न आल्यास टाइमआउट समजून पुन्हा पाठवले जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tiada respons dalam 20 saat, ia dianggap tamat masa dan akan dihantar semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det ikke kommer svar innen 20 sekunder, regnes det som tidsavbrudd og sendes på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komt er binnen 20 seconden geen antwoord, dan geldt dit als time-out en wordt opnieuw verstuurd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 ସେକେଣ୍ଡରେ ଉତ୍ତର ନ ମିଳିଲେ ଟାଇମ୍‌ଆଉଟ୍ ଭାବେ ପୁଣି ପଠାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 ਸਕਿੰਟ ਵਿੱਚ ਜਵਾਬ ਨਾ ਆਵੇ ਤਾਂ ਸਮਾਂ ਸਮਾਪਤ ਮੰਨ ਕੇ ਦੁਬਾਰਾ ਭੇਜਿਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli odpowiedź nie nadejdzie w ciągu 20 sekund, żądanie uznajemy za przeterminowane i wysyłamy ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não houver resposta em 20 segundos, conta como tempo esgotado e o envio é repetido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não houver resposta em 20 segundos, conta como tempo esgotado e o envio é repetido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă nu primește răspuns în 20 de secunde, se consideră expirat și se retrimite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ответа нет за 20 секунд, запрос считается просроченным и будет отправлен повторно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak odpoveď nepríde do 20 sekúnd, požiadavka sa považuje za vypršanú a odošle sa znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se v 20 sekundah ne odzove, se šteje kot časovna omejitev in se pošlje znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om inget svar kommer inom 20 sekunder räknas det som en tidsgräns och skickas igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 வினாடிகளில் பதில் வராவிட்டால் நேரம் முடிந்ததாகக் கருதி மீண்டும் அனுப்பப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 సెకన్లలో స్పందన రాకపోతే సమయం ముగిసినట్లు భావించి మళ్లీ పంపుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไม่มีการตอบกลับใน 20 วินาที จะถือว่าหมดเวลาและส่งใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 saniye içinde yanıt gelmezse zaman aşımı sayılır ve yeniden gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо відповіді немає за 20 секунд, запит вважається простроченим і буде надіслано повторно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 سیکنڈ میں جواب نہ آئے تو اسے ٹائم آؤٹ مان کر دوبارہ بھیجا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có phản hồi sau 20 giây, yêu cầu sẽ hết hạn và được gửi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 20 秒内没有响应，将视为超时并重新发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20 秒內沒有回應時，會視為逾時並重新傳送。"
          }
        }
      }
    },
