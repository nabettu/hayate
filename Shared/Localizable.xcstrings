    "削除すると、まだ送っていない分は送るのをやめます。送り終えたもの・作ったリマインダーは消えません。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الحذف يتوقف إرسال ما لم يُرسل بعد. لا يُحذف ما أُرسل ولا التذكيرات التي أُنشئت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছলে যা এখনো পাঠানো হয়নি তা আর পাঠানো হবে না। যা পাঠানো হয়ে গেছে বা যে রিমাইন্ডার তৈরি হয়েছে তা মুছবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’elimines, el que encara no s’ha enviat no s’enviarà. El que ja s’ha enviat i els recordatoris creats no s’eliminen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po smazání se to, co ještě nebylo odesláno, už nebude odesílat. Již odeslané položky a vytvořené připomínky se nesmažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter den, sendes det, der ikke er sendt endnu, ikke. Det, der allerede er sendt, og påmindelser, der er oprettet, forbliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen wird nicht mehr gesendet, was noch aussteht. Bereits Gesendetes und erstellte Erinnerungen bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν τη διαγράψετε, ό,τι δεν έχει σταλεί ακόμη δεν θα σταλεί. Όσα έχουν ήδη σταλεί και οι υπενθυμίσεις που δημιουργήθηκαν δεν διαγράφονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you delete it, anything not yet sent will not be sent. Items already sent and reminders already created are not removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al borrarla, lo que aún no se haya enviado no se enviará. Lo ya enviado y los recordatorios creados no se borran."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistat sen, vielä lähettämättömiä ei lähetetä. Jo lähetetyt ja luodut muistutukset säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous supprimez, ce qui n’a pas encore été envoyé ne sera plus envoyé. Ce qui a été envoyé et les rappels créés ne sont pas supprimés."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કાઢી નાખશો તો હજુ ન મોકલેલું મોકલવાનું બંધ થશે. મોકલાઈ ગયેલું અને બનાવેલા રિમાઇન્ડર્સ કાઢી નખાશે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם תמחקו, מה שעדיין לא נשלח לא יישלח. מה ששלחתם ותזכורות שנוצרו לא יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाने पर जो अभी तक नहीं भेजा गया, वह नहीं भेजा जाएगा। भेजा जा चुका नोट और बनाए गए रिमाइंडर नहीं हटते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako izbrišete, ono što još nije poslano neće se poslati. Poslano i izrađeni podsjetnici ne brišu se."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törléskor a még el nem küldött részek küldése leáll. Az már elküldött jegyzetek és a létrehozott emlékeztetők megmaradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dihapus, yang belum terkirim tidak akan dikirim. Yang sudah terkirim dan pengingat yang sudah dibuat tidak ikut terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini, ciò che non è ancora stato inviato non verrà inviato. Quanto già inviato e i promemoria creati non vengono eliminati."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಳಿಸಿದರೆ ಇನ್ನೂ ಕಳುಹಿಸದಿರುವುದನ್ನು ಕಳುಹಿಸುವುದಿಲ್ಲ. ಈಗಾಗಲೇ ಕಳುಹಿಸಿದ್ದು ಮತ್ತು ರಚಿಸಿದ ರಿಮೈಂಡರ್‌ಗಳು ಅಳಿಯುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제하면 아직 보내지 않은 분은 보내지 않습니다. 이미 보낸 것과 만든 미리 알림은 지워지지 않습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇല്ലാതാക്കിയാൽ ഇതുവരെ അയച്ചിട്ടില്ലാത്തവ അയയ്ക്കില്ല. അയച്ചുകഴിഞ്ഞവയും സൃഷ്ടിച്ച റിമൈൻഡറുകളും ഇല്ലാതാകില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटवल्यास अजून न पाठवलेले पाठवले जाणार नाही. पाठवून झालेले आणि तयार केलेले रिमाइंडर्स हटवले जात नाहीत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dipadam, yang belum dihantar tidak akan dihantar. Yang sudah dihantar dan peringatan yang telah dibuat tidak dipadam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter, sendes ikke det som ikke er sendt ennå. Det som allerede er sendt, og påminnelser som er opprettet, forblir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je verwijdert, wordt wat nog niet is verstuurd niet meer verstuurd. Wat al is verstuurd en herinneringen die zijn aangemaakt, blijven bestaan."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଲୋପ କଲେ, ଏପର୍ଯ୍ୟନ୍ତ ପଠାଯାଇ ନ ଥିବା ଅଂଶ ପଠାଯିବ ନାହିଁ। ପଠାଇ ସାରିଥିବା ଓ ତିଆରି ହୋଇଥିବା ରିମାଇଣ୍ଡର୍ ମୁଛିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਿਟਾਉਣ ’ਤੇ, ਜੋ ਹਾਲੇ ਨਹੀਂ ਭੇਜਿਆ ਗਿਆ, ਉਹ ਭੇਜਿਆ ਨਹੀਂ ਜਾਵੇਗਾ। ਜੋ ਭੇਜਿਆ ਜਾ ਚੁੱਕਾ ਹੈ ਅਤੇ ਬਣਾਏ ਰਿਮਾਈਂਡਰ ਨਹੀਂ ਮਿਟਣਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po usunięciu niewysłane jeszcze notatki nie zostaną wysłane. To, co już wysłano, i utworzone przypomnienia nie znikną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao excluir, o que ainda não foi enviado deixa de ser enviado. O que já foi enviado e os lembretes criados não são apagados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao eliminar, o que ainda não foi enviado deixa de ser enviado. O que já foi enviado e os lembretes criados não são apagados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ștergere, se oprește trimiterea a ceea ce nu a fost încă trimis. Ce s-a trimis deja și mementourile create nu se șterg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении неотправленное отправляться не будет. Уже отправленное и созданные напоминания не удаляются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odstránení sa neodoslané položky už odosielať nebudú. Už odoslané položky a vytvorené pripomienky sa neodstránia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po brisanju se neposlano ne bo več pošiljalo. Že poslano in ustvarjeni opomniki se ne izbrišejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar den skickas inget mer som inte redan skickats. Det som redan skickats och skapade påminnelser raderas inte."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீக்கினால், இன்னும் அனுப்பப்படாதவை அனுப்பப்படாது. ஏற்கெனவே அனுப்பியவையும் உருவாக்கிய நினைவூட்டல்களும் நீக்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "తొలగిస్తే, ఇంకా పంపనివి పంపబడవు. ఇప్పటికే పంపినవి, సృష్టించిన రిమైండర్‌లు తొలగించబడవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อลบ รายการที่ยังไม่ได้ส่งจะยกเลิกการส่ง ส่วนที่ส่งแล้วและการช่วยเตือนที่สร้างไว้จะไม่ถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silerseniz henüz gönderilmeyenlerin gönderimi iptal edilir. Gönderilmiş olanlar ve oluşturulan anımsatıcılar silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після видалення ненадіслані нотатки не буде надіслано. Уже надіслане й створені нагадування не видаляються."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف کرنے پر جو ابھی نہیں بھیجا گیا اسے بھیجنا بند کر دیا جائے گا۔ جو بھیجا جا چکا ہے اور جو یاد دہانیاں بن چکی ہیں وہ حذف نہیں ہوں گی۔"
