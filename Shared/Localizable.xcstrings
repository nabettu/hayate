    "Series 9 / Ultra 2 以降は、親指と人差し指をダブルタップしても「メモ」を押せます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Series 9 / Ultra 2 أو أحدث، يمكنك أيضًا الضغط على «ملاحظة» بالنقر مرتين بالإبهام والسبابة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 বা পরের মডেলে বুড়ো আঙুল ও তর্জনী দিয়ে ডাবল ট্যাপ করেও “মেমো” চাপা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la Series 9 / Ultra 2 o posterior, també pots prémer «Nota» tocant dues vegades el dit polze i l’índex."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Series 9 / Ultra 2 a novějších můžete „Poznámku“ stisknout také dvojitým klepnutím palce a ukazováčku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra Series 9 / Ultra 2 kan du også trykke på »Note« ved at dobbelttrykke med tommel- og pegefinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab Series 9 / Ultra 2 kannst du „Notiz“ auch per Doppeltippen mit Daumen und Zeigefinger drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από τα Series 9 / Ultra 2 και μετά, μπορείτε να πατήσετε «Σημείωση» και με διπλό άγγιγμα του αντίχειρα και του δείκτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Series 9 / Ultra 2 or later, you can also tap “Memo” by double-tapping your thumb and index finger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir del Series 9 / Ultra 2, también puedes pulsar “Nota” con un doble toque con el pulgar y el índice."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 -mallista alkaen voit painaa ”Muistiinpano”-painiketta myös napauttamalla peukalolla ja etusormella kahdesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’Apple Watch Series 9 / Ultra 2 et ultérieur, vous pouvez aussi toucher deux fois le pouce et l’index (double toucher) pour appuyer sur « Mémo »."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 અને પછીના મૉડલમાં અંગૂઠો અને તર્જની બે વાર અડાડવાથી (ડબલ ટૅપ) પણ “નોંધ” દબાવી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-Series 9 / Ultra 2 ואילך אפשר ללחוץ על “הערה” גם בהקשה כפולה של האגודל והאצבע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 और उसके बाद के मॉडल में अँगूठे और तर्जनी को दो बार छूने (डबल टैप) से भी “नोट” दबाया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na modelima Series 9 / Ultra 2 i novijima „Bilješku” možete pritisnuti i dvostrukim dodirom palca i kažiprsta (dvostruki dodir)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 és újabb óráknál a hüvelyk- és mutatóujj dupla koppintásával is megnyomhatja a „Jegyzet” gombot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Series 9 / Ultra 2 atau lebih baru, Anda juga bisa menekan “Catatan” dengan mengetuk dua kali ibu jari dan jari telunjuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Series 9 / Ultra 2 in poi, puoi premere “Appunto” anche con il doppio tocco di pollice e indice."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 ಮತ್ತು ನಂತರದ ಮಾದರಿಗಳಲ್ಲಿ ಹೆಬ್ಬೆರಳು ಮತ್ತು ತೋರುಬೆರಳಿನಿಂದ ಡಬಲ್ ಟ್ಯಾಪ್ ಮಾಡಿಯೂ “ಟಿಪ್ಪಣಿ” ಒತ್ತಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 이후 모델에서는 엄지와 검지를 더블 탭해도 \"메모\"를 누를 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 മുതലുള്ളവയിൽ, തള്ളവിരലും ചൂണ്ടുവിരലും ഡബിൾ ടാപ്പ് ചെയ്ത് “മെമ്മോ” അമർത്താനും കഴിയും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 व नंतरच्या मॉडेलवर अंगठा आणि तर्जनी डबल टॅप करूनही “मेमो” दाबता येते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada Series 9 / Ultra 2 dan ke atas, anda juga boleh menekan “Memo” dengan mengetik dua kali menggunakan ibu jari dan jari telunjuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Series 9 / Ultra 2 og nyere kan du også trykke «Memo» ved å dobbelttrykke med tommel og pekefinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op Series 9 / Ultra 2 en nieuwer kun je ook op “Memo” drukken door twee keer met duim en wijsvinger te tikken (dubbeltik)."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 ଓ ତା’ ପରର ମଡେଲ୍ ରେ, ବୁଢ଼ା ଆଙ୍ଗୁଠି ଓ ତର୍ଜନୀକୁ ଦୁଇଥର ଟାପ୍ (ଡବଲ୍ ଟାପ୍) କଲେ ମଧ୍ୟ “ନୋଟ୍” ଦବାଇପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 ਜਾਂ ਨਵੇਂ ਮਾਡਲ ’ਤੇ ਅੰਗੂਠੇ ਅਤੇ ਉਂਗਲ ਨੂੰ ਦੋ ਵਾਰ ਜੋੜ ਕੇ (ਡਬਲ ਟੈਪ) ਵੀ “ਨੋਟ” ਦਬਾ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na modelach Series 9 / Ultra 2 i nowszych „Notatkę” można też nacisnąć, stukając dwukrotnie kciukiem i palcem wskazującym (Podwójne stuknięcie)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Series 9 / Ultra 2 ou mais recente, também dá para tocar “Anotar” com um toque duplo do polegar e do indicador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Series 9 / Ultra 2 ou mais recente, também dá para tocar “Anotar” com um toque duplo do polegar e do indicador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe Series 9 / Ultra 2 sau mai noi, poți apăsa „Notiță” și cu gestul Atingere dublă (atinge de două ori degetul mare cu arătătorul)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Series 9 / Ultra 2 и новее нажать «Заметка» можно и двойным касанием большого и указательного пальцев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Series 9 / Ultra 2 a novších môžete „Poznámku“ stlačiť aj dvojitým ťuknutím palca a ukazováka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na modelih Series 9 / Ultra 2 in novejših lahko »Zapisek« pritisnete tudi z dvojnim dotikom s palcem in kazalcem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Series 9 / Ultra 2 eller senare kan du också trycka på ”Anteckning” med dubbeltryck med tumme och pekfinger."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 மற்றும் அதற்குப் பிந்தையவற்றில், கட்டை விரலையும் சுட்டுவிரலையும் இருமுறை தட்டியும் “குறிப்பு” ஐ அழுத்தலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 మరియు తర్వాతి మోడళ్లలో, బొటనవేలు, చూపుడు వేలుతో డబుల్ ట్యాప్ చేసినా “నోట్” నొక్కవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน Series 9 / Ultra 2 ขึ้นไป แตะสองครั้งด้วยนิ้วโป้งและนิ้วชี้ก็กด \"บันทึก\" ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 ve sonrasında başparmak ve işaret parmağınızla çift dokunarak da “Not” düğmesine basabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Series 9 / Ultra 2 і новіших кнопку «Нотатка» можна натиснути й подвійним дотиком великого та вказівного пальців."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 اور اس کے بعد کے ماڈلز میں انگوٹھا اور شہادت کی انگلی ملا کر ڈبل ٹیپ کرنے سے بھی “نوٹ” دبایا جا سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ Series 9 / Ultra 2 trở lên, bạn cũng có thể chạm đúp ngón cái và ngón trỏ để nhấn \"Ghi chú\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 及更新机型，也可以用拇指和食指轻点两下来按“备忘”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Series 9 / Ultra 2 以後的機型，也可以用拇指和食指點兩下來按「備忘」。"
          }
        }
      }
    },
