    "タップすると Hayate が開き、すぐ「メモ」を押せます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لفتح Hayate والضغط على «ملاحظة» فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্যাপ করলে Hayate খুলবে এবং সঙ্গে সঙ্গে “মেমো” চাপতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca per obrir Hayate i prémer «Nota» de seguida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím otevřete Hayate a hned můžete stisknout „Poznámka“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at åbne Hayate og trykke på »Note« med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe darauf, um Hayate zu öffnen und gleich „Notiz“ zu drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να ανοίξει το Hayate και να πατήσετε αμέσως «Σημείωση»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to open Hayate and tap “Memo” right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir Hayate y pulsar “Nota” al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta avataksesi Hayaten ja painaaksesi heti ”Muistiinpano”-painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour ouvrir Hayate et appuyer tout de suite sur « Mémo »."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટૅપ કરવાથી Hayate ખુલે છે અને તરત “નોંધ” દબાવી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשה פותחת את Hayate ומאפשרת ללחוץ מיד על “הערה”."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैप करने पर Hayate खुलता है और तुरंत “नोट” दबाया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirom se otvara Hayate i odmah možete pritisnuti „Bilješka”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintásra megnyílik a Hayate, és rögtön megnyomhatja a „Jegyzet” gombot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk membuka Hayate dan langsung menekan “Catatan”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per aprire Hayate e premere subito “Appunto”."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಟ್ಯಾಪ್ ಮಾಡಿದರೆ Hayate ತೆರೆಯುತ್ತದೆ ಮತ್ತು ತಕ್ಷಣ “ಟಿಪ್ಪಣಿ” ಒತ್ತಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 Hayate가 열리고 바로 \"메모\"를 누를 수 있습니다."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ടാപ്പ് ചെയ്താൽ Hayate തുറന്ന് ഉടൻ “മെമ്മോ” അമർത്താം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टॅप केल्यावर Hayate उघडते आणि लगेच “मेमो” दाबता येतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik untuk membuka Hayate dan terus menekan “Memo”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å åpne Hayate og trykke «Memo» med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om Hayate te openen en meteen op “Memo” te drukken."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଟାପ୍ କଲେ Hayate ଖୋଲିବ ଏବଂ ସଙ୍ଗେ ସଙ୍ଗେ “ନୋଟ୍” ଦବାଇପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਟੈਪ ਕਰਨ ’ਤੇ Hayate ਖੁੱਲ੍ਹੇਗਾ ਅਤੇ ਤੁਸੀਂ ਤੁਰੰਤ “ਨੋਟ” ਦਬਾ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknięcie otwiera Hayate i od razu możesz nacisnąć „Notatka”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar, o Hayate abre e você já pode tocar em “Anotar”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar, o Hayate abre e já pode tocar em “Anotar”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge pentru a deschide Hayate și a putea apăsa imediat „Notiță”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы открыть Hayate и сразу нажать «Заметка»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknutím otvoríte Hayate a hneď môžete stlačiť „Poznámku“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapnite, da odprete Hayate in takoj pritisnete »Zapisek«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att öppna Hayate och trycka på ”Anteckning” direkt."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தட்டினால் Hayate திறந்து, உடனே “குறிப்பு” ஐ அழுத்தலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ట్యాప్ చేస్తే Hayate తెరుచుకుంటుంది, వెంటనే “నోట్” నొక్కవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อเปิด Hayate แล้วกด \"บันทึก\" ได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunduğunuzda Hayate açılır ve hemen “Not” düğmesine basabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться, щоб відкрити Hayate й одразу натиснути «Нотатка»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹیپ کرنے پر Hayate کھلتا ہے اور آپ فوراً “نوٹ” دبا سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để mở Hayate và nhấn \"Ghi chú\" ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点即可打开 Hayate，并立即按“备忘”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下即可開啟 Hayate，並立即按「備忘」。"
          }
        }
      }
