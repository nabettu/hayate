    "「Hey Siri、はやてで送って」と話しかけ、「何を送りますか？」と聞かれたら送りたい内容を話します。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل «Hey Siri، أرسل عبر Hayate»، وعندما تسأل Siri «ماذا تريد أن ترسل؟» قل ما تريد إرساله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বলুন “Hey Siri, Hayate দিয়ে পাঠাও”। “কী পাঠাতে চান?” জিজ্ঞেস করলে যা পাঠাতে চান তা বলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digues «Hey Siri, envia amb Hayate» i, quan et pregunti «Què vols enviar?», digues el contingut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte „Hey Siri, odešli přes Hayate“ a až se Siri zeptá „Co chcete odeslat?“, řekněte obsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig »Hey Siri, send med Hayate«, og sig så, hvad du vil sende, når Siri spørger »Hvad vil du sende?«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sage „Hey Siri, mit Hayate senden“ und nenne auf die Frage „Was möchtest du senden?“ den Inhalt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε «Hey Siri, στείλε με το Hayate» και, όταν το Siri ρωτήσει «Τι θέλετε να στείλετε;», πείτε το περιεχόμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “Hey Siri, send with Hayate,” and when asked “What do you want to send?”, say what you want to send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “Oye Siri, enviar con Hayate” y, cuando pregunte “¿Qué quieres enviar?”, di lo que quieres enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano ”Hey Siri, lähetä sovelluksella Hayate” ja kerro sitten, mitä haluat lähettää, kun Siri kysyy ”Mitä haluat lähettää?”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Dis Siri, envoie avec Hayate », puis, à la question « Que voulez-vous envoyer ? », dites ce que vous souhaitez envoyer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate થી મોકલો” કહો, અને “શું મોકલવું છે?” પૂછે ત્યારે મોકલવાની વાત બોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמרו “Hey Siri, שלח עם Hayate”, וכש-Siri שואלת “מה לשלוח?” אמרו את התוכן לשליחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate से भेजो” कहें, और Siri जब पूछे “क्या भेजना है?” तो जो भेजना है वह बोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite „Hey Siri, pošalji s Hayate” i kad Siri upita „Što želite poslati?”, izgovorite sadržaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondja: „Hey Siri, küldd el a Hayate appal”, majd amikor a Siri megkérdezi, „Mit szeretne küldeni?”, mondja el a tartalmat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katakan \"Hey Siri, kirim dengan Hayate\", lalu saat ditanya \"Apa yang ingin Anda kirim?\", ucapkan isinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ “Ehi Siri, invia con Hayate” e, quando ti viene chiesto “Cosa vuoi inviare?”, di’ cosa vuoi inviare."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate ನಲ್ಲಿ ಕಳುಹಿಸು” ಎನ್ನಿ, “ಏನು ಕಳುಹಿಸಬೇಕು?” ಎಂದು ಕೇಳಿದಾಗ ಕಳುಹಿಸಬೇಕಾದದ್ದನ್ನು ಹೇಳಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Hey Siri, Hayate로 보내줘\"라고 말하고, \"무엇을 보낼까요?\"라고 물으면 보낼 내용을 말하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate വഴി അയയ്ക്കൂ” എന്ന് പറയുക. “എന്താണ് അയയ്ക്കേണ്ടത്?” എന്ന് ചോദിക്കുമ്പോൾ അയയ്ക്കാനുള്ളത് പറയുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate ने पाठवा” म्हणा आणि “काय पाठवायचे?” असे विचारल्यावर पाठवायचे ते बोला."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebut “Hey Siri, hantar dengan Hayate”, kemudian cakap apa yang anda mahu hantar apabila Siri bertanya “Apa yang anda mahu hantar?”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «Hey Siri, send med Hayate», og si deretter hva du vil sende når Siri spør «Hva vil du sende?»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg “Hey Siri, verstuur met Hayate” en zeg wat je wilt versturen als Siri vraagt “Wat wil je versturen?”."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate ରେ ପଠାଅ” କୁହନ୍ତୁ, “ଆପଣ କ’ଣ ପଠାଇବେ?” ପଚାରିଲେ ପଠାଇବାକୁ ଥିବା କଥା କୁହନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, Hayate ਨਾਲ ਭੇਜੋ” ਕਹੋ, ਅਤੇ “ਤੁਸੀਂ ਕੀ ਭੇਜਣਾ ਚਾਹੁੰਦੇ ਹੋ?” ਪੁੱਛਣ ’ਤੇ ਭੇਜਣ ਵਾਲੀ ਗੱਲ ਬੋਲੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „Hey Siri, wyślij przez Hayate”, a gdy Siri zapyta „Co wysłać?”, powiedz treść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Hey Siri, enviar com o Hayate” e, quando ela perguntar “O que você quer enviar?”, diga o conteúdo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Hey Siri, enviar com o Hayate” e, quando ela perguntar “O que quer enviar?”, diga o conteúdo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune „Hey Siri, trimite cu Hayate” și, când te întreabă „Ce vrei să trimiți?”, spune conținutul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «Hey Siri, отправь через Hayate», а когда Siri спросит «Что отправить?», произнесите текст."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povedzte „Hey Siri, odošli cez Hayate“ a keď sa Siri opýta „Čo chcete odoslať?“, povedzte obsah."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite »Hey Siri, pošlji s Hayate« in ko vas Siri vpraša »Kaj želite poslati?«, izgovorite besedilo."
          }
