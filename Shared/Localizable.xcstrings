          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bekapcsolja a „Titkos értékként elrejtés” opciót, az értékek a képernyőn elrejtve jelennek meg. Az értékek csak az iPhone és az óra Keychainjében tárolódnak."
