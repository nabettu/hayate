    "どれもオンにしていなければ、メモとして保存するだけです。あとから iPhone のメモの一覧で送れます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن لم تفعّل أيًّا منها، تُحفظ الملاحظة فقط. يمكنك إرسالها لاحقًا من قائمة الملاحظات على iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনোটিই চালু না থাকলে মেমো শুধু সংরক্ষিত হয়। পরে iPhone-এর মেমো তালিকা থেকে পাঠাতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no n’hi ha cap d’activat, la nota només es desa. Després la pots enviar des de la llista de notes de l’iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když není nic zapnuté, poznámka se jen uloží. Později ji můžete odeslat ze seznamu poznámek v iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis intet er slået til, gemmes noten bare. Du kan sende den senere fra notelisten på iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist nichts aktiviert, wird die Notiz nur gesichert. Du kannst sie später in der Notizenliste auf dem iPhone senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν έχει ενεργοποιηθεί τίποτα, η σημείωση απλώς αποθηκεύεται. Μπορείτε να τη στείλετε αργότερα από τη λίστα σημειώσεων στο iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If none are turned on, the memo is only saved. You can send it later from the memo list on iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay nada activado, la nota solo se guarda. Puedes enviarla después desde la lista de notas del iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos mikään ei ole päällä, muistiinpano vain tallennetaan. Voit lähettää sen myöhemmin iPhonen muistiinpanoluettelosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aucune n’est activée, le mémo est seulement enregistré. Vous pourrez l’envoyer plus tard depuis la liste des mémos de l’iPhone."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જો કોઈ ચાલુ ન હોય, તો નોંધ ફક્ત સાચવાય છે. પછીથી iPhone ની નોંધોની યાદીમાંથી મોકલી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם אף אחד מהם לא מופעל, ההערה רק נשמרת. אפשר לשלוח אותה מאוחר יותר מרשימת ההערות ב-iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी चालू न हो, तो नोट सिर्फ़ सहेजा जाता है। बाद में iPhone की नोट सूची से भेज सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako nijedno nije uključeno, bilješka se samo sprema. Poslije je možete poslati s popisa bilješki na iPhoneu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egyik sincs bekapcsolva, a jegyzet csak mentődik. Később az iPhone jegyzetlistájából elküldheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak ada yang diaktifkan, catatan hanya disimpan. Anda bisa mengirimnya nanti dari daftar catatan di iPhone."
