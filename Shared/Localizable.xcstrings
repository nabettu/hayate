        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಉಳಿಸುವ ಮೊದಲು “ಟೆಸ್ಟ್ ಕಳುಹಿಸಿ” ಮೂಲಕ ಚಾನಲ್‌ನಲ್ಲಿ “ಇದು Hayate ನ ಟೆಸ್ಟ್ ಸಂದೇಶ” ಬರುತ್ತದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하기 전에 \"테스트 전송\"으로 채널에 \"Hayate 테스트 전송입니다\"가 표시되는지 확인하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സേവ് ചെയ്യുന്നതിന് മുമ്പ് “ടെസ്റ്റ് അയയ്ക്കുക” ഉപയോഗിച്ച് ചാനലിൽ “ഇത് Hayate ന്റെ ടെസ്റ്റ് സന്ദേശമാണ്” എത്തുന്നുണ്ടോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव्ह करण्यापूर्वी “टेस्ट पाठवा” ने चॅनेलवर “हा Hayate चा टेस्ट संदेश आहे” येतो का ते तपासा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum menyimpan, gunakan “Hantar ujian” dan semak sama ada “Ini mesej ujian daripada Hayate” muncul dalam saluran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du lagrer: bruk «Send test», og sjekk at «Dette er en testmelding fra Hayate» vises i kanalen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuur vóór het bewaren een testbericht en controleer of “Dit is een testbericht van Hayate” in het kanaal verschijnt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଭ୍ କରିବା ପୂର୍ବରୁ “ଟେଷ୍ଟ ପଠାଣ” ଦ୍ୱାରା ଚ୍ୟାନେଲରେ “ଏହା Hayate ର ଟେଷ୍ଟ ପଠାଣ” ଦେଖାଯାଉଛି କି ଯାଞ୍ଚ କରନ୍ତୁ।"
