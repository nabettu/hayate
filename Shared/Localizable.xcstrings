        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρτέλα «Σημειώσεις» στο iPhone κρατά όλες τις σημειώσεις από το iPhone και το Apple Watch. Το Apple Watch κρατά τις τελευταίες 50."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Memos tab on iPhone keeps all memos entered on iPhone and Apple Watch. Apple Watch keeps the latest 50."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña “Notas” del iPhone conserva todas las notas del iPhone y del Apple Watch. El Apple Watch conserva las últimas 50."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen ”Muistiinpanot”-välilehdellä säilyvät kaikki iPhonessa ja Apple Watchissa kirjoitetut muistiinpanot. Apple Watch säilyttää viimeiset 50."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Mémos de l’iPhone conserve tous les mémos saisis sur l’iPhone et l’Apple Watch. L’Apple Watch garde les 50 derniers."
          }
        },
        "gu" : {
