        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପ୍ରତ୍ୟେକ ମେସେଜ୍ ର ID। ପୁଣି ପଠାଇଲେ ବି ସମାନ, ତେଣୁ ଡୁପ୍ଲିକେଟ୍ ହଟାଇବାକୁ ବ୍ୟବହାର କରିପାରିବେ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਸੁਨੇਹੇ ਦੀ ID। ਦੁਬਾਰਾ ਭੇਜਣ ’ਤੇ ਵੀ ਉਹੀ ਰਹਿੰਦੀ ਹੈ, ਇਸ ਲਈ ਡੁਪਲੀਕੇਟ ਹਟਾਉਣ ਲਈ ਵਰਤ ਸਕਦੇ ਹੋ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID każdej wiadomości. Takie samo przy ponownym wysłaniu, więc nadaje się do usuwania duplikatów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
