      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر التاج الرقمي في وجه الساعة (أو مرّر من الأسفل) لإظهار التكديس الذكي. اضغط مطولًا على أي أداة للدخول في وضع التحرير، ثم اضغط + في الأعلى واختر «Hayate» لإضافته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়াচ ফেসে ডিজিটাল ক্রাউন ঘোরান (বা নিচ থেকে সোয়াইপ করুন), স্মার্ট স্ট্যাক আসবে। যেকোনো উইজেট চেপে ধরে এডিট মোডে যান, ওপরের + থেকে “Hayate” বেছে যোগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A l’esfera, gira la Digital Crown (o llisca des de baix) per obrir la Pila intel·ligent. Mantén premut un widget per editar, prem + a dalt i tria «Hayate»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ciferníku otočte Digital Crown (nebo přejeďte zdola), otevře se Chytrá sada. Podržte libovolný widget pro úpravy, nahoře klepněte na + a vyberte „Hayate“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej på Digital Crown på urskiven (eller stryg op fra bunden) for at vise Smart Stack. Tryk og hold på en widget for at redigere, tryk på + øverst, og vælg »Hayate«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe auf dem Zifferblatt die Digital Crown (oder wische von unten nach oben), um den Smart-Stapel zu öffnen. Halte ein Widget gedrückt, um zu bearbeiten, tippe oben auf + und wähle „Hayate“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην πρόσοψη ρολογιού γυρίστε το Digital Crown (ή σύρετε από κάτω προς τα πάνω) για να εμφανιστεί το Smart Stack. Πατήστε παρατεταμένα οποιοδήποτε widget για επεξεργασία και επιλέξτε «Hayate» από το + στο πάνω μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the watch face, turn the Digital Crown (or swipe up from the bottom) to show the Smart Stack. Touch and hold any widget to enter edit mode, tap + at the top, and choose “Hayate” to add it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la esfera, gira la Digital Crown (o desliza desde abajo) para ver el Smart Stack. Mantén pulsado un widget para editar, toca + arriba y elige “Hayate” para añadirlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännä kellotaululla Digital Crownia (tai pyyhkäise alhaalta ylös), niin Smart Stack tulee näkyviin. Paina jotakin widgetiä pitkään muokkaustilaan, paina yläreunan +-painiketta ja valitse ”Hayate”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le cadran, tournez la Digital Crown (ou balayez depuis le bas) pour afficher la Pile intelligente. Maintenez le doigt sur un widget pour passer en modification, touchez + en haut, puis choisissez « Hayate » pour l’ajouter."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વૉચ ફેસ પર ડિજિટલ ક્રાઉન ફેરવો (અથવા નીચેથી સ્વાઇપ કરો) તો સ્માર્ટ સ્ટૅક આવે છે. કોઈ પણ વિજેટ દબાવી રાખી ફેરફાર મોડમાં જાઓ, ઉપરના + થી “Hayate” પસંદ કરી ઉમેરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתצוגת השעון סובבו את ה-Digital Crown (או החליקו מלמטה) כדי להציג את הערימה החכמה. לחצו לחיצה ארוכה על ווידג׳ט כלשהו למצב עריכה, לחצו + למעלה ובחרו “Hayate” כדי להוסיף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉच फ़ेस पर डिजिटल क्राउन घुमाएँ (या नीचे से स्वाइप करें) तो स्मार्ट स्टैक खुलता है। किसी भी विजेट को दबाए रखकर संपादन मोड में जाएँ, ऊपर + दबाकर “Hayate” चुनें और जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na brojčaniku zavrtite Digital Crown (ili povucite odozdo prema gore) da se prikaže Smart Stack. Dugo pritisnite bilo koji widget za uređivanje i pomoću + gore odaberite „Hayate”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számlapon forgassa a Digital Crownt (vagy csúsztasson alulról felfelé), így megjelenik a Smart Stack. Nyomjon hosszan bármelyik widgetre a szerkesztéshez, majd a felső + gombbal válassza a „Hayate” elemet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar Digital Crown di tampilan jam (atau geser dari bawah) untuk membuka Smart Stack. Tekan lama salah satu widget untuk masuk mode edit, lalu ketuk + di atas dan pilih \"Hayate\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul quadrante ruota la Digital Crown (o scorri dal basso) per aprire lo Smart Stack. Tieni premuto un widget per modificare, tocca + in alto e scegli “Hayate” per aggiungerlo."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಾಚ್ ಫೇಸ್‌ನಲ್ಲಿ ಡಿಜಿಟಲ್ ಕ್ರೌನ್ ತಿರುಗಿಸಿ (ಅಥವಾ ಕೆಳಗಿನಿಂದ ಸ್ವೈಪ್ ಮಾಡಿ), ಸ್ಮಾರ್ಟ್ ಸ್ಟ್ಯಾಕ್ ಬರುತ್ತದೆ. ಯಾವುದೇ ವಿಜೆಟ್ ಅನ್ನು ಒತ್ತಿಹಿಡಿದು ಸಂಪಾದನೆ ಸ್ಥಿತಿಗೆ ಹೋಗಿ, ಮೇಲಿನ + ನಿಂದ “Hayate” ಆರಿಸಿ ಸೇರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계 페이스에서 Digital Crown을 돌리거나 아래에서 위로 스와이프하면 스마트 스택이 나옵니다. 위젯 하나를 길게 눌러 편집 상태로 만든 뒤 위쪽 +에서 \"Hayate\"를 선택해 추가하세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാച്ച് ഫേസിൽ ഡിജിറ്റൽ ക്രൗൺ തിരിക്കുക (അല്ലെങ്കിൽ താഴെ നിന്ന് സ്വൈപ്പ് ചെയ്യുക), സ്മാർട്ട് സ്റ്റാക്ക് വരും. ഏതെങ്കിലും വിജറ്റ് അമർത്തിപ്പിടിച്ച് എഡിറ്റ് അവസ്ഥയിലാക്കി, മുകളിലെ + ൽ നിന്ന് “Hayate” തിരഞ്ഞെടുത്ത് ചേർക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉच फेसवर डिजिटल क्राउन फिरवा (किंवा खालून स्वाइप करा), स्मार्ट स्टॅक येतो. कोणतेही विजेट दाबून धरून संपादन स्थितीत जा, वरील + वरून “Hayate” निवडून जोडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar Digital Crown pada wajah jam (atau leret dari bawah) untuk memaparkan Smart Stack. Tekan lama pada mana-mana widget untuk mengedit, tekan + di atas dan pilih “Hayate”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vri på Digital Crown på urskiven (eller sveip opp fra bunnen) for å vise Smart Stack. Trykk og hold på en widget for å redigere, trykk på + øverst, og velg «Hayate»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai op de wijzerplaat aan de Digital Crown (of veeg van onderen omhoog) om de Slimme stapel te openen. Houd een widget ingedrukt om te bewerken, tik bovenaan op + en kies “Hayate”."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ୱାଚ୍ ଫେସ୍ ରେ ଡିଜିଟାଲ୍ କ୍ରାଉନ୍ ଘୁରାନ୍ତୁ (ବା ତଳୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ), ସ୍ମାର୍ଟ ଷ୍ଟାକ୍ ଦେଖାଯିବ। ଯେକୌଣସି ୱିଜେଟ୍ କୁ ଦୀର୍ଘ ସମୟ ଦବାଇ ଏଡିଟ୍ ମୋଡ୍ ରେ ଉପରର + ରୁ “Hayate” ବାଛି ଯୋଡ଼ନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਾਚ ਫੇਸ ’ਤੇ ਡਿਜੀਟਲ ਕਰਾਊਨ ਘੁੰਮਾਓ (ਜਾਂ ਹੇਠੋਂ ਸਵਾਈਪ ਕਰੋ) ਤਾਂ ਸਮਾਰਟ ਸਟੈਕ ਆਵੇਗਾ। ਕਿਸੇ ਵੀ ਵਿਜੇਟ ਨੂੰ ਦੇਰ ਤੱਕ ਦਬਾ ਕੇ ਸੰਪਾਦਨ ਮੋਡ ਵਿੱਚ ਲਿਆਓ, ਉੱਪਰ + ਤੋਂ “Hayate” ਚੁਣ ਕੇ ਜੋੜੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tarczy zegarka obróć Digital Crown (lub przesuń od dołu), aby otworzyć Inteligentny stos. Przytrzymaj dowolny widżet, aby edytować, naciśnij + u góry i wybierz „Hayate”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mostrador, gire a Digital Crown (ou deslize de baixo para cima) para abrir a Pilha Inteligente. Mantenha um widget pressionado para editar, toque em + no topo e escolha “Hayate”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mostrador, gire a Digital Crown (ou deslize de baixo para cima) para abrir a Smart Stack. Mantenha um widget pressionado para editar, toque em + no topo e escolha “Hayate”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe cadran, rotește Digital Crown (sau glisează de jos în sus) pentru a deschide Smart Stack. Ține apăsat un widget pentru a edita, apasă + sus și alege „Hayate”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На циферблате покрутите Digital Crown (или смахните снизу вверх), чтобы открыть Смарт-стопку. Нажмите и удерживайте любой виджет для редактирования, нажмите + вверху и выберите «Hayate»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ciferníku otočte Digital Crown (alebo potiahnite zdola), otvorí sa Inteligentný zásobník. Podržte ľubovoľný widget na úpravy, hore ťuknite na + a vyberte „Hayate“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na številčnici zavrtite Digital Crown (ali povlecite od spodaj navzgor), da se prikaže Smart Stack. Dolgo pridržite katerikoli pripomoček, da vstopite v urejanje, in s + zgoraj izberite »Hayate«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrid på Digital Crown på urtavlan (eller svep uppåt från nederkanten) för att visa Smart Stack. Tryck länge på en widget för att redigera, tryck på + högst upp och välj ”Hayate”."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வாட்ச் ஃபேஸில் டிஜிட்டல் கிரவுனைச் சுழற்றினால் (அல்லது கீழிருந்து ஸ்வைப் செய்தால்) ஸ்மார்ட் ஸ்டாக் தோன்றும். ஏதேனும் ஒரு விட்ஜெட்டை நீண்ட நேரம் அழுத்தித் திருத்தும் நிலைக்குச் சென்று, மேலே உள்ள + இல் “Hayate” ஐத் தேர்ந்தெடுத்துச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వాచ్ ఫేస్‌లో డిజిటల్ క్రౌన్ తిప్పితే (లేదా కింద నుండి స్వైప్ చేస్తే) స్మార్ట్ స్టాక్ వస్తుంది. ఏదైనా విడ్జెట్‌ను ఎక్కువసేపు నొక్కి ఎడిట్ స్థితికి వెళ్లి, పైన + లో “Hayate” ఎంచుకుని జోడించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนหน้าปัด หมุน Digital Crown (หรือปัดขึ้นจากด้านล่าง) เพื่อเปิด Smart Stack แตะวิดเจ็ตใดก็ได้ค้างไว้เพื่อเข้าสู่โหมดแก้ไข แล้วกด + ด้านบนและเลือก \"Hayate\" เพื่อเพิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadranda Digital Crown’u çevirin (veya aşağıdan yukarı kaydırın), Smart Stack açılır. Herhangi bir widget’a basılı tutarak düzenleme moduna girin ve üstteki + ile “Hayate”i seçip ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На циферблаті покрутіть Digital Crown (або проведіть знизу вгору), щоб відкрити Smart Stack. Натисніть і утримуйте будь-який віджет для редагування, натисніть + угорі й виберіть «Hayate»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واچ فیس پر ڈیجیٹل کراؤن گھمائیں (یا نیچے سے سوائپ کریں) تو سمارٹ اسٹیک کھلتا ہے۔ کسی بھی ویجیٹ کو دبائے رکھ کر ایڈٹ موڈ میں جائیں، اوپر + دبا کر “Hayate” چنیں اور شامل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên mặt đồng hồ, xoay Digital Crown (hoặc vuốt từ dưới lên) để mở Smart Stack. Nhấn giữ một widget bất kỳ để vào chế độ chỉnh sửa, rồi nhấn + ở trên và chọn \"Hayate\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表盘上转动数码表冠（或从下方向上轻扫）会出现智能叠放。长按任意小组件进入编辑状态，点按上方的 +，选择“Hayate”即可添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在錶面上轉動數位錶冠（或從下方向上滑動）即可顯示智慧堆疊。長按任一小工具進入編輯狀態，按上方的 +，選擇「Hayate」加入。"
          }
        }
      }
    },
