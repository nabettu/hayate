        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಟ್ಯಾಪ್ ಮಾಡಿದರೆ Hayate ತೆರೆಯುತ್ತದೆ ಮತ್ತು ತಕ್ಷಣ “ಕಳುಹಿಸಿ” ಒತ್ತಬಹುದು."
          }
        },
        "ko" : {
