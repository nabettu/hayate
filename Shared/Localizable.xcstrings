    "時計の文字盤を長押し →「編集」→ コンプリケーションの枠を選び、一覧の「Hayate」から形を選びます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على وجه الساعة ← «تحرير» ← اختر موضع التعقيد، ثم اختر الشكل من «Hayate» في القائمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘড়ির ওয়াচ ফেসে চেপে ধরুন → “এডিট” → কমপ্লিকেশনের জায়গা বেছে তালিকার “Hayate” থেকে ধরন নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premuda l’esfera → «Edita» → tria un espai per a la complicació i selecciona una forma sota «Hayate» a la llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ciferník → „Upravit“ → vyberte pozici komplikace a v seznamu „Hayate“ → zvolte tvar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på urskiven → »Rediger« → vælg en komplikationsplads, og vælg form under »Hayate« på listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Zifferblatt gedrückt > „Bearbeiten“ > wähle einen Komplikationsplatz und dann unter „Hayate“ in der Liste eine Form."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε παρατεταμένα την πρόσοψη του ρολογιού → «Επεξεργασία» → επιλέξτε θέση complication και, στη λίστα, τη μορφή από το «Hayate»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the watch face > “Edit” > select a complication slot, then choose a shape under “Hayate” in the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la esfera > “Editar” > selecciona un espacio de complicación y elige una forma en “Hayate” en la lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina kellotaulua pitkään → ”Muokkaa” → valitse komplikaatiopaikka ja valitse muoto luettelon ”Hayate”-kohdasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur le cadran > « Modifier » > sélectionnez un emplacement de complication, puis choisissez une forme sous « Hayate » dans la liste."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઘડિયાળના વૉચ ફેસ પર દબાવી રાખો → “ફેરફાર કરો” → કૉમ્પ્લિકેશનની જગ્યા પસંદ કરી યાદીમાંથી “Hayate” ની શૈલી પસંદ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצו לחיצה ארוכה על תצוגת השעון ← “עריכה” ← בחרו מיקום לקומפליקציה, ובחרו צורה מתוך “Hayate” ברשימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वॉच फ़ेस को दबाए रखें → “संपादित करें” → कॉम्प्लिकेशन की जगह चुनें, फिर सूची में “Hayate” से आकार चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dugo pritisnite brojčanik sata → „Uredi” → odaberite mjesto za komplikaciju i na popisu pod „Hayate” odaberite oblik."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomja hosszan az óra számlapját → „Szerkesztés” → válasszon komplikációhelyet, majd a listában a „Hayate” alatt a formát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama tampilan jam → \"Edit\" → pilih slot komplikasi, lalu pilih bentuk dari \"Hayate\" di daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il quadrante > “Modifica” > seleziona uno spazio per complicazione e scegli una forma sotto “Hayate” nell’elenco."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ವಾಚ್‌ನ ವಾಚ್ ಫೇಸ್ ಅನ್ನು ಒತ್ತಿಹಿಡಿಯಿರಿ → “ಸಂಪಾದಿಸಿ” → ಕಾಂಪ್ಲಿಕೇಶನ್ ಸ್ಥಳ ಆರಿಸಿ, ಪಟ್ಟಿಯ “Hayate” ನಿಂದ ಆಕಾರ ಆರಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계 페이스를 길게 누르고 →\"편집\"→ 컴플리케이션 칸을 선택한 뒤 목록의 \"Hayate\"에서 모양을 고르세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാച്ചിന്റെ വാച്ച് ഫേസ് അമർത്തിപ്പിടിക്കുക → “എഡിറ്റ്” → കോംപ്ലിക്കേഷന്റെ സ്ഥാനം തിരഞ്ഞെടുത്ത് പട്ടികയിലെ “Hayate” ൽ നിന്ന് രൂപം തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घड्याळाचा वॉच फेस दाबून धरा → “संपादित करा” → कॉम्प्लिकेशनची जागा निवडा आणि यादीतील “Hayate” मधून आकार निवडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama wajah jam → “Edit” → pilih petak komplikasi dan pilih bentuk di bawah “Hayate” dalam senarai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på urskiven → «Rediger» → velg en komplikasjonsplass, og velg form under «Hayate» i listen."
          }
        },
        "nl" : {
          "stringUnit" : {
