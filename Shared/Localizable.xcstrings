    "Slack で送りたいチャンネル用の Incoming Webhook を作り、URL (https://hooks.slack.com/services/... ) をコピーします。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ Incoming Webhook للقناة التي تريد الإرسال إليها، وانسخ عنوان URL (https://hooks.slack.com/services/... )."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে চ্যানেলে পাঠাতে চান তার জন্য Slack-এ একটি Incoming Webhook বানান এবং URL (https://hooks.slack.com/services/... ) কপি করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Slack, crea un Incoming Webhook per al canal que vulguis i copia l’URL (https://hooks.slack.com/services/... )."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte Incoming Webhook pro kanál Slack, do kterého chcete odesílat, a zkopírujte URL (https://hooks.slack.com/services/... )."
          }
