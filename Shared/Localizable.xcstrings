    "「コピー」「共有」で、ほかのアプリにも渡せます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «نسخ» أو «مشاركة» لتمريرها إلى تطبيقات أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“কপি” বা “শেয়ার” চেপে অন্য অ্যাপেও দিতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prem «Copia» o «Comparteix» per passar-ho a altres apps."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na „Kopírovat“ nebo „Sdílet“ to předáte i jiným aplikacím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med »Kopiér« og »Del« kan du give dem videre til andre apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Kopieren“ und „Teilen“ kannst du sie an andere Apps weitergeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το «Αντιγραφή» και το «Κοινοποίηση» μπορείτε να τα στείλετε και σε άλλες εφαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Copy” or “Share” to pass it to other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con “Copiar” y “Compartir” puedes pasarlas a otras apps."
          }
        },
        "fi" : {
          "stringUnit" : {
