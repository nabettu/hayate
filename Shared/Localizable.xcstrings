          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els errors HTTP 4xx (401 / 403 / 404, etc.) indiquen un error de configuració. Comprova l’URL i la capçalera d’autenticació."
          }
        },
        "cs" : {
          "stringUnit" : {
