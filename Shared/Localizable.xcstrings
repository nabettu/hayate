        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેપ કરતાં Hayate ખુલે છે અને તરત “મોકલો” દબાવી શકાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
