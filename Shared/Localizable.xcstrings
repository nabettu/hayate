          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ঘড়িতে Hayate খুলে বেগুনি “পাঠান” চাপুন, তারপর বলুন বা লিখুন। শেষ হলে “সম্পন্ন” চেপে পাঠান।"
