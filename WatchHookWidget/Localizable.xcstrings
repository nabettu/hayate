    "タップして Hayate を開き、話して送ります。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لفتح Hayate وتحدّث لإرسال ما تقوله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্যাপ করে Hayate খুলুন, বলুন ও পাঠান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca per obrir Hayate, parlar i enviar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím otevřete Hayate, řekněte obsah a odešlete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at åbne Hayate, tal og send."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um Hayate zu öffnen, und sprich, um zu senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για να ανοίξει το Hayate, μιλήστε και στείλτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to open Hayate, then speak to send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir Hayate y habla para enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta avataksesi Hayaten, puhu ja lähetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour ouvrir Hayate, puis parlez pour envoyer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેપ કરીને Hayate ખોલો, બોલો અને મોકલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו כדי לפתוח את Hayate ולדבר כדי לשלוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैप करके Hayate खोलें और बोलकर भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite za otvaranje Hayate, govorite i pošaljite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson a Hayate megnyitásához, beszéljen, és küldje el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk membuka Hayate, lalu bicara untuk mengirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per aprire Hayate e parla per inviare."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಟ್ಯಾಪ್ ಮಾಡಿ Hayate ತೆರೆಯಿರಿ, ಮಾತನಾಡಿ ಮತ್ತು ಕಳುಹಿಸಿ."
