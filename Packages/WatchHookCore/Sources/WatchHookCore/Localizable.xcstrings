    "設定が大きすぎて Apple Watch へ送れません。本文テンプレートやヘッダを減らしてください" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات كبيرة جدًا ولا يمكن إرسالها إلى Apple Watch. قلّل قالب النص أو الترويسات"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস অনেক বড়, তাই Apple Watch-এ পাঠানো যায়নি। বডি টেমপ্লেট বা হেডার কমান"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració és massa gran per enviar-la a l’Apple Watch. Redueix la plantilla del cos o les capçaleres"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení je příliš velké a nelze ho poslat do Apple Watch. Zkraťte šablonu těla nebo záhlaví"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingerne er for store til at blive sendt til Apple Watch. Gør indholdsskabelonen eller headerne mindre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen sind zu groß, um sie an die Apple Watch zu senden. Verkleinere die Inhaltsvorlage oder die Header."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις είναι πολύ μεγάλες για αποστολή στο Apple Watch. Μειώστε το πρότυπο σώματος ή τις κεφαλίδες"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings are too large to send to Apple Watch. Reduce the body template or headers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes son demasiado grandes para enviarlos al Apple Watch. Reduce la plantilla del cuerpo o los encabezados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetukset ovat liian suuret lähetettäviksi Apple Watchiin. Pienennä sisältöpohjaa tai otsikoita"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages sont trop volumineux pour être envoyés à l’Apple Watch. Réduisez le modèle de corps ou les en-têtes."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સેટિંગ ખૂબ મોટા હોવાથી Apple Watch પર મોકલી શકાયા નહીં. બૉડી ટેમ્પ્લેટ કે હેડર ઘટાડો"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרות גדולות מדי ולא ניתן לשלוח אותן ל-Apple Watch. צמצמו את תבנית הגוף או את הכותרות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग बहुत बड़ी है और Apple Watch को नहीं भेजी जा सकती। बॉडी टेम्पलेट या हेडर कम करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke su prevelike za slanje na Apple Watch. Smanjite predložak tijela ili broj zaglavlja"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállítások túl nagyok az Apple Watchra küldéshez. Csökkentse a törzssablont vagy a fejlécek számát"
