        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan terlalu besar untuk dikirim ke Apple Watch. Kurangi templat isi atau header"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni sono troppo grandi per essere inviate all’Apple Watch. Riduci il modello del corpo o gli header."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸೆಟ್ಟಿಂಗ್‌ಗಳು ತುಂಬಾ ದೊಡ್ಡದಾಗಿರುವುದರಿಂದ Apple Watch ಗೆ ಕಳುಹಿಸಲಾಗಲಿಲ್ಲ. ಬಾಡಿ ಟೆಂಪ್ಲೇಟ್ ಅಥವಾ ಹೆಡರ್‌ಗಳನ್ನು ಕಡಿಮೆ ಮಾಡಿ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정이 너무 커서 Apple Watch로 보낼 수 없습니다. 본문 템플릿이나 헤더를 줄여 주세요"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ക്രമീകരണങ്ങൾ വളരെ വലുതായതിനാൽ Apple Watch ലേക്ക് അയയ്ക്കാനായില്ല. ബോഡി ടെംപ്ലേറ്റോ ഹെഡറുകളോ കുറയ്ക്കുക"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज खूप मोठ्या असल्याने Apple Watch वर पाठवता आल्या नाहीत. बॉडी टेम्पलेट किंवा हेडर कमी करा"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapan terlalu besar untuk dihantar ke Apple Watch. Kurangkan templat kandungan atau pengepala"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
