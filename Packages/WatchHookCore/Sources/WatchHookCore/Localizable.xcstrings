          "stringUnit" : {
            "state" : "translated",
            "value" : "సెట్టింగ్‌లు చాలా పెద్దవి, Apple Watch కు పంపలేము. బాడీ టెంప్లేట్ లేదా హెడర్‌లను తగ్గించండి"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่ามีขนาดใหญ่เกินไปจึงส่งไปยัง Apple Watch ไม่ได้ โปรดลดเทมเพลตเนื้อหาหรือเฮดเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar Apple Watch’a gönderilemeyecek kadar büyük. Gövde şablonunu veya başlıkları azaltın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування завеликі й не передаються на Apple Watch. Скоротіть шаблон тіла або заголовки"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیٹنگز بہت بڑی ہیں اور Apple Watch کو نہیں بھیجی جا سکتیں۔ باڈی ٹیمپلیٹ یا ہیڈر کم کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt quá lớn nên không gửi được tới Apple Watch. Hãy bớt mẫu nội dung hoặc header"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置过大，无法发送到 Apple Watch。请精简正文模板或请求头"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定過大，無法傳送到 Apple Watch。請減少內文範本或標頭"
          }
        }
      }
    },
